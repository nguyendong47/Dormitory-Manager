<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Dormitory.Desktop.ViewModels"
        xmlns:views="using:Dormitory.Desktop.Views"
        x:Class="Dormitory.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Hệ Thống Quản Lý Ký Túc Xá - Dormitory Management"
        Icon="/Assets/AppIcon.ico"
        Width="1180" Height="720"
        WindowStartupLocation="CenterScreen">

    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RoomListViewModel}">
            <views:RoomListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EquipmentListViewModel}">
            <views:EquipmentListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StudentListViewModel}">
            <views:StudentListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ContractListViewModel}">
            <views:ContractListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BillListViewModel}">
            <views:BillListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PaymentTransactionListViewModel}">
            <views:PaymentTransactionListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EmployeeListViewModel}">
            <views:EmployeeListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ViolationListViewModel}">
            <views:ViolationListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportListViewModel}">
            <views:ReportListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemSettingsViewModel}">
            <views:SystemSettingsView/>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid>
        <!-- Màn hình Đăng nhập (hiển thị khi chưa đăng nhập) -->
        <views:LoginView DataContext="{Binding LoginVm}"
                         IsVisible="{Binding !IsLoggedIn}"/>

        <!-- Giao diện chính sau khi đăng nhập thành công -->
        <Grid ColumnDefinitions="240,*" IsVisible="{Binding IsLoggedIn}">
            <!-- Sidebar Navigation -->
            <Border Grid.Column="0" Background="{DynamicResource SystemAltMediumHighColor}"
                    BorderBrush="{DynamicResource SystemControlTransientBorderBrush}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto" Margin="16,20,16,16">
                    <!-- App Brand -->
                    <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,24">
                        <TextBlock Text="🏢 KTX DORMITORY" FontSize="18" FontWeight="Bold" Foreground="#0078D4"/>
                        <TextBlock Text="Quản Lý Ký Túc Xá" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                    </StackPanel>

                    <!-- Navigation Buttons -->
                    <StackPanel Grid.Row="1" Spacing="8">
                        <Button Content="📊  Tổng quan"
                                Command="{Binding NavigateToDashboardCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="12,10" CornerRadius="6"/>

                        <Button Content="🏠  Phòng ở"
                                Command="{Binding NavigateToRoomsCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="12,10" CornerRadius="6"/>

                        <Button Content="🛋️  Quản lý tài sản"
                                Command="{Binding NavigateToEquipmentsCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="12,10" CornerRadius="6"/>

                        <Button Content="🎓  Sinh viên"
                                Command="{Binding NavigateToStudentsCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="12,10" CornerRadius="6"/>

                        <Button Content="📝  Hợp đồng"
                                Command="{Binding NavigateToContractsCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="12,10" CornerRadius="6"/>

                        <Button Content="💵  Hóa đơn &amp; Dịch vụ"
                                Command="{Binding NavigateToBillsCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="12,10" CornerRadius="6"/>

                        <Button Content="💳  Giao dịch đối soát"
                                Command="{Binding NavigateToTransactionsCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="12,10" CornerRadius="6"/>

                        <Button Content="👤  Nhân viên"
                                Command="{Binding NavigateToEmployeesCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="12,10" CornerRadius="6"/>

                        <Button Content="⚖️  Kỷ luật &amp; Vi phạm"
                                Command="{Binding NavigateToViolationsCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="12,10" CornerRadius="6"/>

                        <Button Content="📊  Báo cáo &amp; Thống kê"
                                Command="{Binding NavigateToReportsCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="12,10" CornerRadius="6"/>

                        <Button Content="⚙️  Cài đặt hệ thống"
                                Command="{Binding NavigateToSettingsCommand}"
                                IsVisible="{Binding IsAdmin}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="12,10" CornerRadius="6"/>
                    </StackPanel>

                    <!-- Footer Info & Đăng xuất -->
                    <StackPanel Grid.Row="2" Spacing="8">
                        <Separator Margin="0,0,0,4"/>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding CurrentUserName, StringFormat='👤 {0}'}" 
                                       FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CurrentUserRole}" 
                                       FontSize="11" Foreground="#0078D4" FontWeight="Medium"/>
                        </StackPanel>

                        <Button Content="🚪 Đăng xuất"
                                Command="{Binding LogoutCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="8,8"
                                CornerRadius="6"
                                Background="Transparent"
                                BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                                BorderThickness="1"/>

                        <TextBlock Text=".NET 8 LTS • Avalonia UI 11" 
                                   FontSize="11" 
                                   Foreground="{DynamicResource SystemBaseMediumColor}" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Border Grid.Column="1" Background="{DynamicResource SystemChromeMediumLowColor}">
                <TransitioningContentControl Content="{Binding CurrentView}"/>
            </Border>
        </Grid>
    </Grid>
</Window>
