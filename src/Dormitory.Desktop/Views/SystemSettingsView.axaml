<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Dormitory.Desktop.ViewModels"
             xmlns:dto="using:Dormitory.Application.DTOs"
             x:Class="Dormitory.Desktop.Views.SystemSettingsView"
             x:DataType="vm:SystemSettingsViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Spacing="20">
            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Cài Đặt Hệ Thống &amp; Quản Trị CSDL" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="Quản lý sao lưu, phục hồi dữ liệu và thông tin cơ sở dữ liệu SQLite" 
                               Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="13"/>
                </StackPanel>

                <!-- Status indicator when loading -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Width="120" Height="4" VerticalAlignment="Center"/>
                    <Button Content="🔄 Làm mới thông tin" 
                            Command="{Binding LoadDatabaseInfoCommand}"
                            Padding="12,8"
                            CornerRadius="6"/>
                </StackPanel>
            </Grid>

            <!-- Status Message Bar -->
            <Border Background="#EBF3FC" BorderBrush="#0078D4" BorderThickness="1" CornerRadius="6" Padding="12,8"
                    IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#0078D4" FontSize="13" FontWeight="Medium"/>
            </Border>

            <!-- Card 1: Thông Tin Cơ Sở Dữ Liệu -->
            <Border Background="{DynamicResource SystemAltHighColor}"
                    BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="💾" FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock Text="Thông Tin Cơ Sở Dữ Liệu" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="8,0,0,0">
                        <!-- Đường dẫn tệp CSDL -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Đường dẫn file:" FontWeight="Medium"
                                   Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,4,16,4"/>
                        <SelectableTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DatabaseInfo.DatabasePath}"
                                             FontFamily="Consolas, Menlo, Monospace" FontSize="13"
                                             TextWrapping="Wrap" Margin="0,4,0,4"/>

                        <!-- Dung lượng tệp -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Dung lượng:" FontWeight="Medium"
                                   Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,4,16,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DatabaseInfo.FormattedFileSize}"
                                   FontWeight="SemiBold" Margin="0,4,0,4"/>

                        <!-- Tổng số bản ghi -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Tổng số bản ghi:" FontWeight="Medium"
                                   Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,4,16,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DatabaseInfo.TotalRecords, StringFormat='{}{0:N0} bản ghi'}"
                                   FontWeight="SemiBold" Foreground="#0078D4" Margin="0,4,0,4"/>

                        <!-- Cập nhật lần cuối -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Cập nhật lần cuối:" FontWeight="Medium"
                                   Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,4,16,4"/>
                        <TextBlock Grid.Row="3" Grid.Column="1"
                                   Text="{Binding DatabaseInfo.LastModified, StringFormat='{}{0:dd/MM/yyyy HH:mm:ss}', Mode=OneWay}"
                                   Margin="0,4,0,4"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 2: Sao Lưu Dữ Liệu (Backup) -->
            <Border Background="{DynamicResource SystemAltHighColor}"
                    BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="📦" FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock Text="Sao Lưu Dữ Liệu (Backup)" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Tạo bản sao lưu an toàn của cơ sở dữ liệu ký túc xá dưới dạng tệp .bak hoặc .db. Bản sao lưu bao gồm toàn bộ dữ liệu phòng, sinh viên, hợp đồng, hóa đơn và tài khoản."
                               Foreground="{DynamicResource SystemBaseMediumColor}"
                               TextWrapping="Wrap"
                               FontSize="13"/>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="💾  Tạo bản sao lưu (.bak)"
                                Command="{Binding BackupCommand}"
                                Background="#0078D4"
                                Foreground="White"
                                FontWeight="SemiBold"
                                CornerRadius="6"
                                Padding="16,10"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 3: Phục Hồi Dữ Liệu (Restore) -->
            <Border Background="#FFF8E1"
                    BorderBrush="#FFA000"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="⚠️" FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock Text="Phục Hồi Dữ Liệu (Restore)" FontSize="16" FontWeight="SemiBold" Foreground="#B78103" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Khối cảnh báo an toàn -->
                    <Border Background="#FFF3CD" BorderBrush="#FFEBAA" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="CẢNH BÁO NGUY HIỂM:" FontWeight="Bold" Foreground="#D83B01"/>
                            <TextBlock Text="Chỉ dành cho Quản trị viên (Admin). Thao tác này sẽ ghi đè toàn bộ dữ liệu hiện tại trong hệ thống bằng dữ liệu từ tệp sao lưu. Vui lòng đảm bảo bạn đã tạo bản sao lưu dữ liệu mới nhất trước khi thực hiện."
                                       Foreground="#856404"
                                       TextWrapping="Wrap"
                                       FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button Content="🔄  Khôi phục CSDL từ file..."
                                Command="{Binding RestoreCommand}"
                                Background="#D83B01"
                                Foreground="White"
                                FontWeight="SemiBold"
                                CornerRadius="6"
                                Padding="16,10"
                                IsEnabled="{Binding IsAdmin}"/>

                        <TextBlock Text="⚠️ Bạn cần quyền Quản trị viên (Admin) để phục hồi"
                                   IsVisible="{Binding !IsAdmin}"
                                   Foreground="#D83B01"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 4: Cấu Hình Máy Chủ Gửi Email (SMTP) -->
            <Border Background="{DynamicResource SystemAltHighColor}"
                    BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="📧" FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock Text="Cấu Hình Máy Chủ Gửi Email (SMTP)" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Cấu hình thông số máy chủ gửi email SMTP để hệ thống tự động gửi thông báo hóa đơn tiền phòng và điện nước kèm tệp PDF phiếu thu tới sinh viên."
                               Foreground="{DynamicResource SystemBaseMediumColor}"
                               TextWrapping="Wrap"
                               FontSize="13"/>

                    <!-- Khối thông báo trạng thái Email -->
                    <Border Background="#EBF3FC" BorderBrush="#0078D4" BorderThickness="1" CornerRadius="6" Padding="12,8"
                            IsVisible="{Binding EmailStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding EmailStatusMessage}" Foreground="#0078D4" FontSize="13" FontWeight="Medium"/>
                    </Border>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4,0,0">
                        <!-- Cột 1, Hàng 0: Máy chủ SMTP -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12" Spacing="6">
                            <TextBlock Text="Máy chủ SMTP (Server):" FontWeight="Medium" FontSize="13"/>
                            <TextBox Text="{Binding EmailSettings.SmtpServer}" Watermark="Ví dụ: smtp.gmail.com hoặc mock"/>
                        </StackPanel>

                        <!-- Cột 2, Hàng 0: Cổng Port -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,0,12" Spacing="6">
                            <TextBlock Text="Cổng kết nối (Port):" FontWeight="Medium" FontSize="13"/>
                            <TextBox Text="{Binding EmailSettings.SmtpPort}" Watermark="Mặc định: 587 hoặc 465"/>
                        </StackPanel>

                        <!-- Cột 1, Hàng 1: Email người gửi -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,12" Spacing="6">
                            <TextBlock Text="Địa chỉ Email gửi (From):" FontWeight="Medium" FontSize="13"/>
                            <TextBox Text="{Binding EmailSettings.SenderEmail}" Watermark="Ví dụ: ktx@university.edu.vn"/>
                        </StackPanel>

                        <!-- Cột 2, Hàng 1: Tên hiển thị người gửi -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,12" Spacing="6">
                            <TextBlock Text="Tên người gửi (Display Name):" FontWeight="Medium" FontSize="13"/>
                            <TextBox Text="{Binding EmailSettings.SenderName}" Watermark="Ban Quản lý Ký túc xá"/>
                        </StackPanel>

                        <!-- Cột 1, Hàng 2: Tên đăng nhập -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,12" Spacing="6">
                            <TextBlock Text="Tên đăng nhập SMTP (Username):" FontWeight="Medium" FontSize="13"/>
                            <TextBox Text="{Binding EmailSettings.Username}" Watermark="Tài khoản email đăng nhập"/>
                        </StackPanel>

                        <!-- Cột 2, Hàng 2: Mật khẩu -->
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="12,0,0,12" Spacing="6">
                            <TextBlock Text="Mật khẩu SMTP (App Password):" FontWeight="Medium" FontSize="13"/>
                            <TextBox Text="{Binding EmailSettings.Password}" PasswordChar="•" Watermark="Mật khẩu ứng dụng"/>
                        </StackPanel>

                        <!-- Cột 1 & 2, Hàng 3: Checkboxes -->
                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="24" Margin="0,4,0,8">
                            <CheckBox Content="Sử dụng mã hóa an toàn SSL / TLS"
                                      IsChecked="{Binding EmailSettings.EnableSsl}"/>
                            <CheckBox Content="Kích hoạt tự động gửi email (Bỏ chọn để dùng chế độ Mock / Safe Mode)"
                                      IsChecked="{Binding EmailSettings.IsEnabled}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0" VerticalAlignment="Center">
                        <Button Content="🧪  Kiểm tra kết nối SMTP"
                                Command="{Binding TestSmtpConnectionCommand}"
                                IsEnabled="{Binding !IsEmailTesting}"
                                CornerRadius="6"
                                Padding="16,10"/>

                        <Button Content="💾  Lưu cấu hình Email"
                                Command="{Binding SaveEmailSettingsCommand}"
                                Background="#0078D4"
                                Foreground="White"
                                FontWeight="SemiBold"
                                CornerRadius="6"
                                Padding="16,10"/>

                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsEmailTesting}" Width="100" Height="4" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 5: Cấu hình Tài khoản Ngân hàng Thụ hưởng & VietQR (NAPAS 247) -->
            <Border Background="{DynamicResource SystemAltHighColor}"
                    BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="💳" FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock Text="Cấu Hình Tài Khoản Ngân Hàng Thụ Hưởng &amp; VietQR (NAPAS 247)" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Cấu hình thông tin tài khoản ngân hàng ký túc xá để tự động sinh mã VietQR chuẩn NAPAS 247 trên hóa đơn và cửa sổ quét mã tại quầy thu ngân."
                               Foreground="{DynamicResource SystemBaseMediumColor}"
                               TextWrapping="Wrap"
                               FontSize="13"/>

                    <!-- Khối thông báo trạng thái Ngân hàng -->
                    <Border Background="#EBF3FC" BorderBrush="#0078D4" BorderThickness="1" CornerRadius="6" Padding="12,8"
                            IsVisible="{Binding BankStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding BankStatusMessage}" Foreground="#0078D4" FontSize="13" FontWeight="Medium"/>
                    </Border>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4,0,0">
                        <!-- Cột 1 & 2, Hàng 0: CheckBox bật VietQR -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="24" Margin="0,0,0,12">
                            <CheckBox Content="Kích hoạt tính năng thanh toán quét mã VietQR trong toàn hệ thống"
                                      IsChecked="{Binding BankSettings.IsEnabled}"/>
                        </StackPanel>

                        <!-- Cột 1 & 2, Hàng 1: Ngân hàng thụ hưởng -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,12" Spacing="6">
                            <TextBlock Text="Ngân hàng thụ hưởng (Napas 247):" FontWeight="Medium" FontSize="13"/>
                            <ComboBox ItemsSource="{Binding AvailableBanks}"
                                      SelectedItem="{Binding SelectedBank}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="dto:BankInfoDto">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding ShortName}" FontWeight="SemiBold" Width="120"/>
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                            <TextBlock Text="{Binding Bin, StringFormat='(BIN: {0})'}" Foreground="#0078D4" FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Cột 1, Hàng 2: Số tài khoản thụ hưởng -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,12" Spacing="6">
                            <TextBlock Text="Số tài khoản ngân hàng thụ hưởng:" FontWeight="Medium" FontSize="13"/>
                            <TextBox Text="{Binding BankSettings.AccountNumber}" Watermark="Ví dụ: 0123456789"/>
                        </StackPanel>

                        <!-- Cột 2, Hàng 2: Tên chủ tài khoản thụ hưởng -->
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="12,0,0,12" Spacing="6">
                            <TextBlock Text="Tên chủ tài khoản (Account Name):" FontWeight="Medium" FontSize="13"/>
                            <TextBox Text="{Binding BankSettings.AccountHolder}" Watermark="BAN QUAN LY KTX"/>
                        </StackPanel>

                        <!-- Cột 1, Hàng 3: Mẫu hiển thị QR -->
                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,12,12" Spacing="6">
                            <TextBlock Text="Mẫu giao diện VietQR QuickLink (Template):" FontWeight="Medium" FontSize="13"/>
                            <ComboBox ItemsSource="{Binding AvailableTemplates}"
                                      SelectedItem="{Binding BankSettings.QrTemplate}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <!-- Cột 2, Hàng 3: Tiền tố nội dung CK -->
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="12,0,0,12" Spacing="6">
                            <TextBlock Text="Tiền tố nội dung chuyển khoản (Prefix):" FontWeight="Medium" FontSize="13"/>
                            <TextBox Text="{Binding BankSettings.TransferPrefix}" Watermark="KTX"/>
                        </StackPanel>
                    </Grid>

                    <!-- Vùng xem trước mã QR thử nghiệm -->
                    <Border Background="{DynamicResource SystemChromeLowColor}"
                            BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,4,0,0">
                        <Grid ColumnDefinitions="Auto,*">
                            <!-- Ảnh xem trước QR -->
                            <Border Grid.Column="0"
                                    Width="160" Height="160"
                                    Background="White"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                                <Panel>
                                    <TextBlock Text="Chưa tạo mã QR"
                                               Foreground="{DynamicResource SystemBaseMediumColor}"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding PreviewQrBitmap, Converter={x:Static ObjectConverters.IsNull}}"/>
                                    <Image Source="{Binding PreviewQrBitmap}"
                                           Width="150" Height="150"
                                           Stretch="Uniform"
                                           IsVisible="{Binding PreviewQrBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                </Panel>
                            </Border>

                            <!-- Hướng dẫn & Nút hành động -->
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="10">
                                <TextBlock Text="Xem trước mã VietQR kiểm tra:" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="Bấm 'Thử nghiệm tạo mã QR' bên dưới để kiểm tra tính năng sinh mã QR chuẩn NAPAS 247 theo các thông số ngân hàng đã cấu hình."
                                           Foreground="{DynamicResource SystemBaseMediumColor}"
                                           TextWrapping="Wrap"
                                           FontSize="13"/>
                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                    <Button Content="🧪  Thử nghiệm tạo mã QR"
                                            Command="{Binding TestGenerateQrCommand}"
                                            CornerRadius="6"
                                            Padding="14,8"/>
                                    <Button Content="💾  Lưu cấu hình Ngân hàng"
                                            Command="{Binding SaveBankSettingsCommand}"
                                            Background="#0078D4"
                                            Foreground="White"
                                            FontWeight="SemiBold"
                                            CornerRadius="6"
                                            Padding="16,8"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
