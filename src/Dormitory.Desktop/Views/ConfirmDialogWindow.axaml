<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Dormitory.Desktop.Views.ConfirmDialogWindow"
        Title="Xác nhận"
        Width="420"
        SizeToContent="Height"
        MinWidth="380"
        MaxWidth="480"
        MinHeight="180"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

    <Border Padding="24" Background="{DynamicResource SystemAltHighColor}">
        <Grid RowDefinitions="*,Auto">
            <!-- Khu vực nội dung thông báo -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,24">
                <!-- Icon cảnh báo -->
                <Border Grid.Column="0"
                        Width="44" Height="44"
                        CornerRadius="22"
                        Background="#FFF8E1"
                        VerticalAlignment="Top"
                        Margin="0,0,16,0">
                    <TextBlock Text="⚠️"
                               FontSize="22"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Tiêu đề và nội dung -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                    <TextBlock x:Name="TitleTextBlock"
                               Text="Xác nhận"
                               FontSize="16"
                               FontWeight="Bold"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="MessageTextBlock"
                               Text="Bạn có chắc chắn muốn thực hiện hành động này?"
                               FontSize="14"
                               Foreground="{DynamicResource SystemBaseMediumColor}"
                               TextWrapping="Wrap"
                               LineHeight="20"/>
                </StackPanel>
            </Grid>

            <!-- Nút thao tác -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="12">
                <Button x:Name="CancelButton"
                        Content="Hủy"
                        Width="90"
                        Height="34"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        CornerRadius="6"
                        Click="OnCancelClick"/>
                <Button x:Name="ConfirmButton"
                        Content="Đồng ý"
                        Width="100"
                        Height="34"
                        Background="#0078D4"
                        Foreground="White"
                        FontWeight="SemiBold"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        CornerRadius="6"
                        Click="OnConfirmClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
