<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Dormitory.Desktop.ViewModels"
             xmlns:dto="using:Dormitory.Application.DTOs"
             x:Class="Dormitory.Desktop.Views.BillListView"
             x:DataType="vm:BillListViewModel"
             x:Name="BillViewRoot">

    <Grid RowDefinitions="Auto,*" Margin="24">
        <!-- Header & Action Bar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Quản Lý Hóa Đơn &amp; Thu Tiền" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="Tính tiền phòng, điện nước và ghi nhận thanh toán dịch vụ hàng tháng" 
                           Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="13"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Content="🔄 Làm mới" Command="{Binding LoadBillsCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Main Content (Toolbar + DataGrid) -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <!-- Toolbar thao tác hóa đơn -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12" VerticalAlignment="Center">
                <Button Content="➕ Lập hóa đơn mới" 
                        Command="{Binding CreateBillCommand}"
                        Background="#0078D4" 
                        Foreground="White" 
                        FontWeight="SemiBold"/>
                <Button Content="💵 Đánh dấu đã thanh toán" 
                        Command="{Binding MarkPaidCommand}"/>
                <Button Content="🗑️ Xóa hóa đơn" 
                        Command="{Binding DeleteBillCommand}"/>
                <Button Content="💳  Quét VietQR" 
                        Command="{Binding OpenVietQrDialogCommand}" 
                        CommandParameter="{Binding SelectedBill}" 
                        IsEnabled="{Binding SelectedBill, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Background="#107C41"
                        Foreground="White"
                        FontWeight="SemiBold"/>
                <Button Content="📄  In phiếu thu (PDF)" 
                        Command="{Binding ExportBillPdfCommand}" 
                        CommandParameter="{Binding SelectedBill}" 
                        IsEnabled="{Binding SelectedBill, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <Button Content="📧  Gửi email hóa đơn" 
                        Command="{Binding SendBillEmailCommand}" 
                        CommandParameter="{Binding SelectedBill}" 
                        IsEnabled="{Binding SelectedBill, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <Button Content="📊  Xuất Excel" 
                        Command="{Binding ExportToExcelCommand}"/>

                <TextBlock Text="Lọc trạng thái:" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="Medium"/>
                <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                          SelectedItem="{Binding SelectedStatusFilter}"
                          Width="220"
                          VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Main DataGrid -->
            <Border Grid.Row="1" Background="{DynamicResource SystemAltHighColor}"
                    CornerRadius="8" Padding="8" BorderBrush="{DynamicResource SystemControlTransientBorderBrush}" BorderThickness="1">
                <DataGrid ItemsSource="{Binding Bills}"
                          SelectedItem="{Binding SelectedBill}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          CanUserResizeColumns="True"
                          BorderThickness="0">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="💳 Quét mã VietQR (NAPAS 247)" 
                                      Command="{Binding OpenVietQrDialogCommand}" 
                                      CommandParameter="{Binding SelectedBill}"/>
                            <MenuItem Header="📄 In phiếu thu (PDF)" 
                                      Command="{Binding ExportBillPdfCommand}" 
                                      CommandParameter="{Binding SelectedBill}"/>
                            <MenuItem Header="📧 Gửi email hóa đơn" 
                                      Command="{Binding SendBillEmailCommand}" 
                                      CommandParameter="{Binding SelectedBill}"/>
                            <MenuItem Header="💵 Đánh dấu đã thanh toán" 
                                      Command="{Binding MarkPaidCommand}"/>
                            <MenuItem Header="🗑️ Xóa hóa đơn" 
                                      Command="{Binding DeleteBillCommand}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã hóa đơn" Binding="{Binding BillCode, Mode=OneWay}" Width="150"/>
                        <DataGridTextColumn Header="Số phòng" Binding="{Binding RoomNumber, Mode=OneWay}" Width="90"/>
                        <DataGridTextColumn Header="Tòa nhà" Binding="{Binding Building, Mode=OneWay}" Width="120"/>
                        <DataGridTextColumn Header="Tháng" Binding="{Binding Month, Mode=OneWay}" Width="70"/>
                        <DataGridTextColumn Header="Năm" Binding="{Binding Year, Mode=OneWay}" Width="70"/>
                        <DataGridTextColumn Header="Tiền phòng (đ)" Binding="{Binding RoomFee, StringFormat='{}{0:N0}', Mode=OneWay}" Width="120"/>
                        <DataGridTextColumn Header="Điện (kWh)" Binding="{Binding ElectricUsage, StringFormat='{}{0:N0}', Mode=OneWay}" Width="90"/>
                        <DataGridTextColumn Header="Tiền điện (đ)" Binding="{Binding ElectricFee, StringFormat='{}{0:N0}', Mode=OneWay}" Width="110"/>
                        <DataGridTextColumn Header="Nước (m3)" Binding="{Binding WaterUsage, StringFormat='{}{0:N0}', Mode=OneWay}" Width="80"/>
                        <DataGridTextColumn Header="Tiền nước (đ)" Binding="{Binding WaterFee, StringFormat='{}{0:N0}', Mode=OneWay}" Width="110"/>
                        <DataGridTextColumn Header="Phụ phí (đ)" Binding="{Binding OtherServiceFee, StringFormat='{}{0:N0}', Mode=OneWay}" Width="100"/>
                        <DataGridTextColumn Header="Tổng cộng (đ)" Binding="{Binding TotalAmount, StringFormat='{}{0:N0}', Mode=OneWay}" Width="130"/>
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status, Mode=OneWay}" Width="120"/>
                        <DataGridTextColumn Header="Hạn nộp" Binding="{Binding DueDate, StringFormat='{}{0:dd/MM/yyyy}', Mode=OneWay}" Width="110"/>
                        <DataGridTemplateColumn Header="Thao tác" Width="260">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:BillDto">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Content="💳 VietQR"
                                                ToolTip.Tip="Mở cửa sổ quét mã VietQR động thanh toán tại quầy"
                                                Command="{Binding #BillViewRoot.((vm:BillListViewModel)DataContext).OpenVietQrDialogCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="8,3" FontSize="11"
                                                Background="#107C41"
                                                Foreground="White"/>
                                        <Button Content="📄 In PDF"
                                                ToolTip.Tip="In phiếu thu tiền phòng &amp; dịch vụ định dạng PDF"
                                                Command="{Binding #BillViewRoot.((vm:BillListViewModel)DataContext).ExportBillPdfCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="8,3" FontSize="11"/>
                                        <Button Content="📧 Gửi mail"
                                                ToolTip.Tip="Gửi email thông báo kèm tệp PDF phiếu thu tới sinh viên"
                                                Command="{Binding #BillViewRoot.((vm:BillListViewModel)DataContext).SendBillEmailCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="8,3" FontSize="11"
                                                Background="#0078D4"
                                                Foreground="White"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
